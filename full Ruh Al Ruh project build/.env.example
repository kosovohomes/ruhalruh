# Copy to .env.local and fill in values. Never commit real credentials.

# Application
NODE_ENV=development
APP_URL=http://localhost:3000
LOG_LEVEL=info
DEBUG=false

# Hosted database (Neon). Use the pooled connection string, including
# ?sslmode=require. Leave blank for local in-memory stores.
DATABASE_URL=

# Token signing secret. At least 32 characters. Generate with a secure random source.
AUTH_SECRET=

# AI provider — Phase 3 uses a local preview provider and ignores these values.
# Fill them in only when an external provider is approved; verify the model name then.
OPENAI_API_KEY=
AI_MODEL=

# Voice providers (Phase 5)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Optional infrastructure
REDIS_URL=
SENTRY_DSN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
